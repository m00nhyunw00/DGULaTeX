# BackEnd server
PORT=5000
SESSION_TTL_MS=3600000

# Comma-separated allowed browser origins.
# Development: http://localhost:5173
# Deployment example: http://dgulatex.online
CORS_ORIGIN=http://localhost:5173

# AI assistant
# Replace this value only on real servers/local machines. Do not commit BackEnd/.env.
OPENAI_API_KEY=your_openai_api_key

# Authentication
AUTH_MODE=DB
LDAP_URL=ldap://your_ldap_host
LDAP_PORT=389

# LaTeX compiler
COMPILER_TEST_MODE=false
LATEX_DOCKER_IMAGE=dgu-latex-compiler
UPLOADS_ROOT=public

# MySQL
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=dgu_latex
DB_CONNECTION_LIMIT=10
